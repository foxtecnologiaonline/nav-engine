{
  "name": "@nav-engine/adapter-fastify",
  "version": "0.1.0",
  "private": true,
  "description": "Adapter HTTP (Fastify) do nav-engine: expõe POST /message e /audio sobre um NavEngine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@nav-engine/core": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "fastify": "^5.2.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
